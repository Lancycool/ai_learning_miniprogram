API_KEY=replace-with-your-deepseek-api-key
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash
REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
BLOCKED_TERMS=赌博教程,毒品交易,制作炸弹
CORS_ORIGINS=*
ENABLE_WEB_SEARCH=True
TAVILYSEARCH_API_KEY=replace-with-your-tavily-api-key
# TAVILY_API_KEY is also supported; TAVILYSEARCH_API_KEY takes precedence.
TAVILY_SEARCH_TIMEOUT_SECONDS=10
TAVILY_FALLBACK_TIMEOUT_SECONDS=5
TAVILY_SEARCH_BUDGET_SECONDS=20
TAVILY_MAX_RETRIES=1
TAVILY_MAX_CONCURRENCY=4
TAVILY_QUEUE_TIMEOUT_SECONDS=1
TAVILY_CIRCUIT_FAILURE_THRESHOLD=5
TAVILY_CIRCUIT_COOLDOWN_SECONDS=30
QUIZ_GENERATION_BUDGET_SECONDS=55
