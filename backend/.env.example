QUIZ_TASK_WORKERS=2
QUIZ_TASK_POLL_SECONDS=1
QUIZ_TASK_TIMEOUT_SECONDS=90
QUIZ_TASK_QUEUE_TIMEOUT_SECONDS=600

# Private documents / Beijing native DashScope API. Feature remains off until verified.
ENABLE_KNOWLEDGE_BASE=False

# Maintenance-only key for GET /api/v1/maintenance/knowledge-traces; never expose it to the frontend.
KNOWLEDGE_TRACE_ADMIN_KEY=replace-with-maintenance-only-key
# Query visibility window for retrieval traces and bad cases.
KNOWLEDGE_TRACE_RETENTION_DAYS=30

