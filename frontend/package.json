{
  "name": "bamboo-quiz-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "竹知岛 AI 闯关学习小程序 MVP",
  "scripts": {
    "test:web-search": "node tests/web-search.cjs",
    "test:quiz-tasks": "node tests/quiz-tasks.cjs",
    "test:knowledge": "node tests/knowledge.cjs && node tests/knowledge-pages.cjs",
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "serve:h5": "python scripts/serve_h5.py --port 8765",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.28.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "24.3.0",
    "@types/react": "18.3.28",
    "@types/webpack-env": "1.18.8",
    "babel-preset-taro": "4.2.1",
    "css-loader": "7.1.2",
    "sass": "1.92.1",
    "style-loader": "4.0.0",
    "react-refresh": "0.14.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.19.0"
}
